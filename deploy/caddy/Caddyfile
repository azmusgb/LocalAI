# HTTPS in front of the appliance. Certificates come from Caddy's own local certificate authority, so no public
# domain or internet access is needed; each device trusts that authority once (download: /localai-ca.crt).
# LOCALAI_NAME and LOCALAI_HOST_IP are set by deploy/Install-LocalAI-HTTPS.ps1. LOCALAI_REMOTE_NAME is this computer's
# Tailscale name (for example localai-pc.tail1234.ts.net), for reaching Local AI away from home; without Tailscale it is
# a placeholder that nothing resolves. Never pass it empty: an empty site address makes Caddy drop every host match.
{
	local_certs
	skip_install_trust
	# Browsers send no server name when connecting by IP address; answer with the IP's certificate.
	default_sni {$LOCALAI_HOST_IP}
}

(ca_download) {
	handle /localai-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=localai-ca.crt"
		file_server
	}
}

(appliance) {
	import ca_download

	# LocalAI Materials (Filament Inventory)
	@materials path /materials /materials/*
	handle @materials {
		reverse_proxy {$LOCALAI_MATERIALS_PROXY:host.docker.internal:3000}
	}

	# LocalAI Terminal (Workshop OS Local Portal)
	@terminal path /terminal /terminal/*
	handle @terminal {
		reverse_proxy {$LOCALAI_WORKSHOP_PROXY:10.0.0.124:80}
	}

	handle {
		# Streams (chat replies) pass straight through; long image runs have no proxy timeout.
		# A deploy recreates the appliance; while it is gone its name doesn't resolve ("dial tcp: lookup
		# local-ai-appliance ... failed"). Requests wait and retry for up to 20 s instead of failing at once.
		reverse_proxy local-ai-appliance:3080 {
			flush_interval -1
			lb_try_duration 20s
			lb_try_interval 500ms
		}
	}
	import updating
}

# Still gone after 20 s (a deploy backs up the database while the appliance is stopped): say Local AI is updating.
# API calls (and /healthz) get JSON with Retry-After (app/public/app.js reads it as "updating"); pages get one that
# retries itself. Takes effect on: docker exec local-ai-https caddy reload --config /etc/caddy/Caddyfile
(updating) {
	handle_errors 502 503 504 {
		header Retry-After 5
		header Cache-Control no-store
		@api path /api/* /healthz
		handle @api {
			header Content-Type application/json
			respond `{"error":"Local AI is updating","updating":true}` 503
		}
		handle {
			header Content-Type "text/html; charset=utf-8"
			respond `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light dark"><meta http-equiv="refresh" content="5"><title>Local AI is updating</title></head><body style="font-family:system-ui,sans-serif;max-width:32rem;margin:20vh auto;padding:0 16px;line-height:1.5"><h1 style="font-size:1.4rem">Local AI is updating, back in a moment</h1><p>This page tries again every few seconds.</p></body></html>` 503
		}
	}
}

https://{$LOCALAI_NAME}, https://{$LOCALAI_HOST_IP}, https://localhost {
	tls internal
	import appliance
}

# The Tailscale name gets its own site: Caddy hands *.ts.net names to the Tailscale daemon for certificates unless an
# automation policy names them explicitly, and from inside Docker it can't reach that daemon, so every handshake would
# fail. Spelling out the internal issuer here (lifetime is its default) gives the name its own policy, so it keeps the
# same local certificate authority every device already trusts.
https://{$LOCALAI_REMOTE_NAME:localai.remote.invalid} {
	tls {
		issuer internal {
			lifetime 12h
		}
	}
	import appliance
}

# Plain HTTP: hand out the CA certificate (so a device can trust it before its first HTTPS visit), else redirect.
http://{$LOCALAI_NAME}, http://{$LOCALAI_HOST_IP}, http://{$LOCALAI_REMOTE_NAME:localai.remote.invalid}, http://localhost {
	import ca_download
	handle {
		redir https://{host}{uri} 308
	}
}
