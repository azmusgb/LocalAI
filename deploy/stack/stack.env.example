# C:\LocalAI\stack\stack.env: secrets and host-specific values for deploy\stack\compose.yml. Never commit it.
# Export-LocalAI-StackEnv.ps1 writes it from a running stack; Install-LocalAI-Stack.ps1 creates one for a new host.

# This computer's LAN address and the HTTPS name (deploy\caddy\Caddyfile).
LOCALAI_HOST_IP=10.0.0.21
LOCALAI_NAME=localai.home.arpa
# Optional: this computer's Tailscale name (tailscale status --json → Self.DNSName, without the final dot), for
# opening Local AI away from home. Leave empty without Tailscale.
LOCALAI_REMOTE_NAME=
TZ=America/New_York

# Optional companions on the Mac (Health shows them as optional).
MAC_AI_HOME_URL=
MAC_DSH_URL=

# Optional: the Workshop display beside the printer (docs/WORKSHOP-DISPLAY.md). Empty means http://10.0.0.124.
# Give the display a DHCP reservation in the router so this address doesn't change.
LOCALAI_WORKSHOP_URL=
# Optional: the display's read-only printer-status token (docs/WORKSHOP-DISPLAY.md › Printer status). Secret.
LOCALAI_WORKSHOP_STATUS_TOKEN=
# Optional: the display's sign-in code token (docs/WORKSHOP-DISPLAY.md › Sign-in code). Secret.
LOCALAI_WORKSHOP_CODE_TOKEN=

# PowerShell Workbench: must match C:\LocalAI\powershell-bridge\ui-token.txt and host-token.txt.
POWERSHELL_UI_TOKEN=
POWERSHELL_BRIDGE_TOKEN=

# Encrypts the credentials n8n stores. Keep a copy: without it, n8n's saved credentials can't be read.
N8N_ENCRYPTION_KEY=

SEARXNG_SECRET=

# n8n code sandbox. SANDBOX_API_KEYS is the key n8n's assistant uses to reach the sandbox.
N8N_SANDBOX_VERSION=1.5.0
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=
