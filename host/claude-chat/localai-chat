#!/bin/sh
# LocalAI chat CLI wrapper: resolves symlinks, then runs cli.mjs next to the real script.
target="$0"
while [ -h "$target" ]; do
  dir=$(cd "$(dirname "$target")" && pwd)
  link=$(readlink "$target")
  case "$link" in /*) target="$link" ;; *) target="$dir/$link" ;; esac
done
here=$(cd "$(dirname "$target")" && pwd)
exec node "$here/cli.mjs" "$@"
